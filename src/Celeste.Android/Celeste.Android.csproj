<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-android</TargetFramework>
    <SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <ApplicationId>celestegame.app</ApplicationId>
    <ApplicationTitle>CELESTE</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <RuntimeIdentifiers>android-arm;android-arm64</RuntimeIdentifiers>
    <EmbeddedContentRoot>$(MSBuildProjectDirectory)\ContentPackage</EmbeddedContentRoot>
    <EmbeddedContentDirectory>$(EmbeddedContentRoot)\Content</EmbeddedContentDirectory>
    <AndroidStoreUncompressedFileExtensions>$(AndroidStoreUncompressedFileExtensions);.xnb;.bank;.bin;.xml;.meta;.fnt;.data</AndroidStoreUncompressedFileExtensions>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.*" />
    <PackageReference Include="MonoGame.Framework.Android" Version="3.8.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Celeste.Core\Celeste.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AndroidAsset Include="..\..\CONTROLES CELESTE\*.png"
                  Link="controls_custom/%(Filename)%(Extension)" />
    <AndroidAsset Include="..\..\CONTROLES CELESTE\*.dat"
                  Link="controls_custom/%(Filename)%(Extension)" />
    <AndroidAsset Include="..\..\ARQUIVOSPARAOANALOGICO\*.png"
                  Link="analog_custom/%(Filename)%(Extension)" />
    <AndroidAsset Include="..\..\ARQUIVOSPARAOANALOGICO\*.dat"
                  Link="analog_custom/%(Filename)%(Extension)" />
    <AndroidAsset Include="$(EmbeddedContentDirectory)\**\*"
                  Exclude="$(EmbeddedContentDirectory)\ErrorFont.xnb"
                  Link="Content\%(RecursiveDir)%(Filename)%(Extension)"
                  Condition="Exists('$(EmbeddedContentDirectory)')" />
  </ItemGroup>

  <ItemGroup>
    <AndroidNativeLibrary Include="..\..\FMOD-11.014\api\lowlevel\lib\armeabi-v7a\libfmod.so" />
    <AndroidNativeLibrary Include="..\..\FMOD-11.014\api\lowlevel\lib\arm64-v8a\libfmod.so" />
    <AndroidNativeLibrary Include="..\..\FMOD-11.014\api\studio\lib\armeabi-v7a\libfmodstudio.so" />
    <AndroidNativeLibrary Include="..\..\FMOD-11.014\api\studio\lib\arm64-v8a\libfmodstudio.so" />
    <AndroidJavaLibrary Include="..\..\FMOD-11.014\api\lowlevel\lib\fmod.jar" />
  </ItemGroup>

  <Target Name="ValidateEmbeddedContent" BeforeTargets="Build">
    <Error Condition="!Exists('$(EmbeddedContentDirectory)')"
           Text="Embedded Content directory not found at '$(EmbeddedContentDirectory)'. Run scripts/fetch-content.ps1 or scripts/fetch-content.sh before building Android." />
  </Target>

</Project>
